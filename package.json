{
  "name": "useinfinitescroll",
  "version": "0.1.0",
  "description": "A tiny, race-safe, SSR-safe React hook for infinite scrolling built on IntersectionObserver. Zero dependencies, fully typed, 100% tested.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "keywords": [
    "react",
    "hook",
    "hooks",
    "infinite-scroll",
    "intersection-observer",
    "pagination",
    "tanstack-query",
    "scrolling",
    "typescript"
  ],
  "license": "MIT",
  "author": "Murat Yuksel <yukselm736@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muratyksl/useInfiniteScroll.git"
  },
  "homepage": "https://github.com/muratyksl/useInfiniteScroll#readme",
  "bugs": {
    "url": "https://github.com/muratyksl/useInfiniteScroll/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query.d.ts",
        "default": "./dist/query.js"
      },
      "require": {
        "types": "./dist/query.d.cts",
        "default": "./dist/query.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm typecheck && vite build && pnpm build:types",
    "build:demo": "vite build --config vite.config.demo.ts",
    "build:types": "tsc -p tsconfig.lib.json && node scripts/emit-cts-types.mjs",
    "check:package": "publint",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "lint": "eslint .",
    "prepublishOnly": "pnpm test:run && pnpm build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
